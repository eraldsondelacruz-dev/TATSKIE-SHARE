{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TATSKIE-SHARE",
  "version": "988.0.3",
  "identifier": "com.tatskie.share",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TATSKIE-SHARE 988.0.3",
        "width": 1200,
        "height": 800,
        "minWidth": 850,
        "minHeight": 600
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}